# SPOTTER configuration.
#
# Copy this file to `.env` (next to package.json) on the machine that runs
# SPOTTER, or set the same variables in your host's environment settings.
# `.env` is git-ignored: never commit it, never paste its values anywhere
# else — not into chat, not into the SPOTTER UI. SPOTTER never shows them.
#
# Everything is optional for the demo: with no values at all, `npm run dev`
# starts on simulated data with an embedded database.
# API_SETUP.md explains, step by step, where each credential comes from.

# --- App ---------------------------------------------------------------------

# Public base URL. OAuth redirect URIs are derived from it
# (e.g. https://spotter.example.com/api/oauth/youtube/callback). Use https in
# production: session cookies are Secure there.
APP_URL=http://localhost:3000

# PostgreSQL. Leave empty to use the embedded PGlite database under
# PGLITE_DATA_DIR (single process, fine for trying SPOTTER, not for production).
# `docker compose up -d db` starts a local PostgreSQL matching this URL:
# DATABASE_URL=postgres://spotter:spotter@localhost:5432/spotter
DATABASE_URL=
PGLITE_DATA_DIR=.data/pglite
# Apply database migrations on start (both web server and worker; they take a lock).
AUTO_MIGRATE=true

# 32 random bytes, base64. Encrypts OAuth tokens at rest. REQUIRED in production.
# Generate one with:   openssl rand -base64 32
# Keep it safe: without it, stored tokens cannot be decrypted (reconnect needed).
TOKEN_ENCRYPTION_KEY=
# During a key rotation: the old key here, the new one above.
TOKEN_ENCRYPTION_KEY_PREVIOUS=

# debug | info | warn | error        json | pretty
LOG_LEVEL=
LOG_FORMAT=

# Run the scheduler/worker inside the web server (simplest). Set false and run
# `npm run worker` as a separate process for larger deployments.
RUN_WORKER_IN_WEB=true
WORKER_POLL_INTERVAL_MS=15000

# --- YouTube (Google Cloud project) ------------------------------------------

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: lets public discovery run before a channel is connected. Restrict it
# to the YouTube Data API v3 in the Google Cloud console.
YOUTUBE_API_KEY=
# PKCE (S256) on Google sign-in. Leave true unless your OAuth client rejects it.
GOOGLE_OAUTH_PKCE=true
# Quota buckets (defaults match a new Google Cloud project, checked 2026-09-29).
YOUTUBE_DAILY_QUOTA=10000
YOUTUBE_SEARCH_DAILY_LIMIT=100
YOUTUBE_BATCH_STATS_DAILY_LIMIT=10000
# Share of each bucket kept back for manual refreshes (0–0.5).
YOUTUBE_QUOTA_RESERVE_FRACTION=0.1
# Set true ONLY after YouTube approves your project for the "Analytics &
# Reporting" use case (Developer Policies III.L). Until then YouTube data is
# shown but not scored, classified or used for personalisation.
YOUTUBE_DERIVED_METRICS_APPROVED=false

# --- Instagram (Meta app) ----------------------------------------------------

# instagram_login (default): your own professional account only.
# facebook_login: adds Business Discovery and Hashtag Search; needs a Facebook
# Page linked to the Instagram account.
INSTAGRAM_AUTH_MODE=instagram_login
# From "Instagram API setup with Instagram login" in the Meta app dashboard.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Only for INSTAGRAM_AUTH_MODE=facebook_login.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_LOGIN_CONFIG_ID=
META_GRAPH_API_VERSION=v26.0

# --- TikTok ------------------------------------------------------------------

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- AI (all optional: the built-in provider works offline) -------------------

# local | anthropic | openai        (Settings → AI overrides this when set there)
AI_PROVIDER=
# Blank = provider default (claude-opus-5-5 for Anthropic, gpt-6-luna for OpenAI).
AI_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# An OpenAI-compatible server instead of api.openai.com, e.g. Ollama:
# OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_BASE_URL=
# local | openai | voyage
EMBEDDING_PROVIDER=
# Blank = text-embedding-3-small (OpenAI) or voyage-4-lite (Voyage), 512 dimensions.
EMBEDDING_MODEL=
VOYAGE_API_KEY=
# Clustering thresholds for a remote embedding model, as JSON, e.g.
# {"join":0.58,"create":0.62}. Get a suggestion from your own data with
# `npm run calibrate:embeddings`.
EMBEDDING_THRESHOLDS=

# --- Public privacy and terms pages ------------------------------------------

# Shown on /privacy and /terms, the URLs you give Google, Meta and TikTok as
# your privacy policy and terms of service. Who runs this installation, and an
# email address or URL for privacy questions (YouTube requires a contact).
OPERATOR_NAME=
PRIVACY_CONTACT=

# --- Optional features ---------------------------------------------------------

# Manual capture: paste a link to a post you saw plus the numbers the app
# showed you. Nothing is fetched or automated. Off by default.
ASSISTED_DISCOVERY_ENABLED=false

# Demo only: inject connector faults to see failure handling, e.g.
# MOCK_FAULTS=tiktok:rate_limited,instagram:auth_expired
MOCK_FAULTS=
